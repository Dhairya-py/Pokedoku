    baby: bool = False
    regional: str = ''
    mega: bool = False
    gigantamax: bool = False
    dynamax: bool = True
    form: str = ''

@dataclass(frozen=True)
class Category:
    label: str
    check: Callable[[Pokemon], bool]
    kind: str

@dataclass
class Puzzle:
    rows: Tuple[Category, Category, Category]
    cols: Tuple[Category, Category, Category]
    solutions: Dict[Tuple[int, int], List[Pokemon]]
FALLBACK_POKEMON: List[Pokemon] = [Pokemon('Bulbasaur', 'bulbasaur', 'bulbasaur', ('Grass', 'Poison'), 1, starter=True), Pokemon('Charizard', 'charizard', 'charizard', ('Fire', 'Flying'), 1, fully_evolved=True, dynamax=True), Pokemon('Mega Charizard X', 'charizard-mega-x', 'charizard', ('Fire', 'Dragon'), 6, fully_evolved=True, mega=True, dynamax=False, form='mega-x'), Pokemon('Gigantamax Charizard', 'charizard-gmax', 'charizard', ('Fire', 'Flying'), 8, fully_evolved=True, gigantamax=True, dynamax=True, form='gmax'), Pokemon('Squirtle', 'squirtle', 'squirtle', ('Water',), 1, starter=True), Pokemon('Pikachu', 'pikachu', 'pikachu', ('Electric',), 1, dynamax=True), Pokemon('Alolan Raichu', 'raichu-alola', 'raichu', ('Electric', 'Psychic'), 7, fully_evolved=True, regional='Alolan'), Pokemon('Mewtwo', 'mewtwo', 'mewtwo', ('Psychic',), 1, legendary=True, fully_evolved=True), Pokemon('Treecko', 'treecko', 'treecko', ('Grass',), 3, starter=True), Pokemon('Rayquaza', 'rayquaza', 'rayquaza', ('Dragon', 'Flying'), 3, legendary=True, fully_evolved=True), Pokemon('Lucario', 'lucario', 'lucario', ('Fighting', 'Steel'), 4, fully_evolved=True), Pokemon('Greninja', 'greninja', 'greninja', ('Water', 'Dark'), 6, fully_evolved=True), Pokemon('Rowlet', 'rowlet', 'rowlet', ('Grass', 'Flying'), 7, starter=True), Pokemon('Galarian Zigzagoon', 'zigzagoon-galar', 'zigzagoon', ('Dark', 'Normal'), 8, regional='Galarian'), Pokemon('Cinderace', 'cinderace', 'cinderace', ('Fire',), 8, fully_evolved=True), Pokemon('Zacian', 'zacian', 'zacian', ('Fairy',), 8, legendary=True, fully_evolved=True, dynamax=False), Pokemon('Sprigatito', 'sprigatito', 'sprigatito', ('Grass',), 9, starter=True), Pokemon('Meowscarada', 'meowscarada', 'meowscarada', ('Grass', 'Dark'), 9, fully_evolved=True), Pokemon('Koraidon', 'koraidon', 'koraidon', ('Fighting', 'Dragon'), 9, legendary=True, fully_evolved=True)]
